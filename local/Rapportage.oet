<?xml version="1.0" encoding="UTF-8"?>
<template xmlns="openEHR/v1/Template" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <id>ed7b00de-0752-4d4b-97dc-2623c29fdadc</id>
  <name>Rapportage</name>
  <description>
    <original_author>
      <item>
        <key>name</key>
        <value>Sebastian Iancu</value>
      </item>
      <item>
        <key>organisation</key>
